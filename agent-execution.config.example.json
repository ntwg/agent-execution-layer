{
  "configVersion": 5,
  "enabled": true,
  "organizationUrl": "https://dev.azure.com/your-org",
  "project": "your-project",
  "repositoryId": "your-repository-id",
  "defaultBranch": "main",
  "defaultAgent": "codex",
  "defaultWorkItemType": "Task",
  "defaultAreaPath": "your-project",
  "defaultIterationPath": "your-project",
  "workItemFieldDefaults": {
    "create": {},
    "done": {}
  },
  "sharedTags": ["agent-managed"],
  "agents": [
    {
      "key": "codex",
      "tag": "agent:codex",
      "branchPrefix": "codex",
      "defaultAssignee": ""
    },
    {
      "key": "claude",
      "tag": "agent:claude",
      "branchPrefix": "claude",
      "defaultAssignee": ""
    }
  ],
  "stateMap": {
    "new": "New",
    "active": "Active",
    "done": "Closed"
  },
  "prDefaults": {
    "reviewerMode": "off",
    "reviewerRequired": false,
    "syncWorkItemTags": true,
    "syncTagMode": "non-agent"
  },
  "reportDefaults": {
    "staleDays": 7,
    "recentDays": 7
  },
  "cleanupDefaults": {
    "staleBranchDays": 14,
    "stalePullRequestDays": 7
  },
  "coordination": {
    "areaTags": ["auth", "db", "frontend", "pipeline", "infra", "migration"],
    "humanBlockReasons": {
      "waiting-on-human": "waiting-on-human",
      "human-approval-needed": "human-approval-needed",
      "external-setup-needed": "external-setup-needed"
    }
  },
  "branching": {
    "developmentBranches": ["main"],
    "rolloutBranches": ["prod"],
    "branchAliases": {
      "default": "main",
      "main": "main",
      "prod": "prod"
    }
  },
  "hierarchyDefaults": {
    "initiativeType": "Initiative",
    "featureType": "Feature",
    "backlogItemType": "Product Backlog Item",
    "taskType": "Task"
  },
  "runtime": {
    "platform": "auto"
  }
}
